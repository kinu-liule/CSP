{
  "apiVersion": 1,
  "id": 1,
  "title": "CyberSec Platform Overview",
  "tags": ["cybersec", "api-gateway"],
  "timezone": "browser",
  "panels": [
    {
      "title": "HTTP Requests Rate",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "rate(http_requests_total[5m])",
          "legendFormat": "{{route}} ({{method}})",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Request Duration (p99)",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket[5m]))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Request Duration (p50)",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(http_request_duration_seconds_bucket[5m]))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "HTTP Errors by Status",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "rate(http_requests_total{status_code=~\"4..|5..\"}[5m])",
          "legendFormat": "{{status_code}} - {{route}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Node.js Process Metrics",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "process_cpu_user_seconds_total",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Memory Usage",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 16 },
      "targets": [
        {
          "expr": "process_resident_memory_bytes",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Event Loop Lag",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 16 },
      "targets": [
        {
          "expr": "nodejs_event_loop_lag_seconds",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Active Handles",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "nodejs_active_handles_total",
          "refId": "A"
        }
      ]
    },
    {
      "title": "HTTP Request Duration Heatmap",
      "type": "heatmap",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 20 },
      "targets": [
        {
          "expr": "rate(http_request_duration_seconds_bucket[5m])",
          "refId": "A"
        }
      ]
    }
  ],
  "schemaVersion": 38,
  "version": 1
}
